# Tutti i valori VITE_ sono PUBBLICI. Nessun segreto serve al portfolio.
BASE_PATH=/
# Destinazione pubblica approvata: https://francehws.github.io/arena-digital-portfolio/
# Per Pages usare BASE_PATH=/arena-digital-portfolio/; verificare il deploy prima di dichiararlo online.
SITE_URL=
VITE_CONTACT_EMAIL=
# Numero internazionale solo cifre, senza + o spazi.
VITE_WHATSAPP_NUMBER=393517324068
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=https://www.instagram.com/arenafrancescovito02/

# URL delle demo ORIGINALI. Senza URL, il sito non mostra simulazioni sostitutive.
# Solo .env.local può usare indirizzi locali; il deploy richiede URL HTTPS pubblici.
VITE_TAVQI_DEMO_URL=
VITE_RECEPTIONIST_DEMO_URL=
VITE_AUTO_DEMO_URL=
VITE_FPS_DEMO_URL=
# Quattro anteprime native approvate il 7 novembre 2026. Il workflow Pages imposta 1.
# La build pubblica include solo i quattro PNG espliciti, mai l'intera cartella.
VITE_NATIVE_PREVIEWS=0
